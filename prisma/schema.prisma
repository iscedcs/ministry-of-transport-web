// ==================== INDEXES & CONSTRAINTS ====================
// All indexes defined above within model blocks for clarity
// Row-Level Security (RLS) will be enforced at the application layer via server actions
// Example pattern in docs/.copilot-instructions.md under "Server Actions & RLS Pattern"

// ==================== PARK MONITOR MODULE ====================
// Reference: docs/PARK MONITOR.md

model ParkMonitorApplication {
  id     String  @id @default(cuid())
  userId String? @unique // Link to User once approved

  // SECTION A: Biodata
  surname            String
  firstName          String
  otherNames         String?
  gender             String  @db.VarChar(10) // MALE/FEMALE
  age                Int
  stateOfOrigin      String
  lga                String
  communityTown      String
