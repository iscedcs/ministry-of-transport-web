  enableEmailNotifications   Boolean             @default(true)
  enableSmsNotifications     Boolean             @default(true)
  enableApplicationAlerts    Boolean             @default(true)
  enableRenewalReminders     Boolean             @default(true)
  enablePaymentNotifications Boolean             @default(true)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id String @id @default(cuid())

  notificationType NotificationType
  recipientUserId  String
  channel          NotificationChannel @default(BOTH)

  // Message content
  subject     String
  messageBody String @db.Text

