  idCardPaymentId      String? // Link to Payment
  idCardIssued         Boolean   @default(false)
  idCardIssuedAt       DateTime?
  idCardIssuedByUserId String? // HOD who issued it
  idCardUrl            String?   @db.VarChar(500)
  qrCodeUrl            String?   @db.VarChar(500)

  // System
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([idCardIssued])
}

// ==================== REVALIDATION MODULE ====================
// Reference: docs/anambra_mot_revalidation_form_2026.md

model RevalidationDraft {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stepReached Int      @default(1)
  data        Json
  updatedAt   DateTime @updatedAt
}

model RevalidationApplication {
  id String @id @default(cuid())

  // SECTION A: APPLICANT DETAILS
  ownerName             String
  ownershipType         String? @db.VarChar(50)
  cacRegistrationNumber String?
  representativeName    String?
  designation           String?
  phoneNumber           String?
  alternatePhoneNumber  String?
  emailAddress          String?
  residentialAddress    String? @db.Text

  // SECTION B: ASIN DETAILS
  asinNumber         String
  nin                String?
  tin                String?
  revalidationNumber String? @unique

  // LINKED ENTITIES FOR REVALIDATION (Carry-Forward & Non-Duplicate Updates)
  motorParkId          String?
  massTransitCompanyId String?

  // SECTION C: MOTOR PARK INFORMATION
  parkName         String
  facilityType     String? @db.VarChar(50)
  facilitySubTypes Json?
  physicalLocation String? @db.Text
  townCommunity    String?
  lga              String?

  // SECTION D: OPERATIONAL INFORMATION
  yearEstablished    String?
  operationalStatus  String? @db.VarChar(50)
  dailyVehiclesCount String? @db.VarChar(50)
  vehicleTypes       String? @db.Text

  // SECTION E: FACILITIES AVAILABLE (JSON)
  facilitiesAvailable Json?

  // SECTION F: REGULATORY COMPLIANCE
  existingApprovalNum String?
  maintainsManifest   Boolean?
  operatorsRegistered Boolean?
  paymentsUpToDate    Boolean?
  safetySignages      Boolean?
  pendingSanctions    Boolean?
  sanctionDetails     String? @db.Text

  // SECTION G: EMPLOYMENT & SECURITY DATA
  managementStaffCount Int     @default(0)
  adminStaffCount      Int     @default(0)
  securityStaffCount   Int     @default(0)
  otherStaffCount      Int     @default(0)
  otherStaffDetails    String? @db.VarChar(100)
  securityArrangement  String? @db.VarChar(50)

  // SECTION H: REVENUE INFORMATION
  estimatedDailyRevenue   Int?
  estimatedMonthlyRev     Int?
  revenueCollectionMethod String? @db.VarChar(50)

  /// Services offered, e.g. Inter-State, Intra-State, Keke, Logistics.
  serviceTypes     Json?
  /// Routes plied, e.g. ["Nnewi - Kwara state"].
  routes           Json?

  // DOCUMENT
  passportPhotoUrl String? @db.VarChar(500)
  passportPhotoId  String?

  // ── LEGACY IMPORT PROVENANCE ──
  /// "VENDOR_IMPORT" for records migrated from the previous vendor's system;
  /// null for applications submitted through this portal.
  dataSource        String?   @db.VarChar(30)
  /// The vendor's own record id, kept so the two registers can be reconciled.
  legacyRecordId    String?   @db.VarChar(50)
  /// The vendor's form serial. Retained for reference only — this application
  /// is issued a fresh revalidation number once the Commissioner approves.
  legacyFormSerial  String?   @db.VarChar(60)
  /// Which of the vendor's field agents captured the record.
  legacyCapturedBy  String?   @db.VarChar(50)
  importedAt        DateTime?
  /// Sections the applicant must still complete, e.g. ["F","H"]. Empty or null
  /// once the record is whole.
  incompleteSections Json?

  // SYSTEM & TRACKING
  applicantUserId String?
  status          ApplicationStatus @default(SUBMITTED)

  // INSPECTION & APPROVAL (Official Use)
  inspectionDate      DateTime?
  inspectionOfficerId String?
  findings            String?   @db.Text
  recommendation      String?   @db.VarChar(50)

  // PS clearance of the inspection SCHEDULE (before the inspector attends).
  inspectionApprovedAt        DateTime?
  inspectionApprovedByUserId  String?
  inspectionRejectionReason   String?   @db.Text

  // Inspector's submission
  inspectionCompletedAt DateTime?
  /// Item-by-item verification of what the applicant declared in Sections
  /// E, F and G. JSON array of
  /// { key, section, label, declared, verified: "YES"|"NO"|"PARTIAL", note }.
  inspectionChecklist   Json?
  /// Evidence captured on site — JSON array of { url, caption }.
  evidenceUrls          Json?

  // Reason recorded when the application is rejected outright
  rejectionReason String? @db.Text

  // ── Certificate terms (printed on the revalidation letter) ──
  /// Monthly operational fee that applies going forward, in kobo.
  monthlyFeeAmount         Int?
  /// Prior monthly fee, in kobo. Set only when the fee was reviewed — the
  /// letter then reads "reviewed from X to Y" instead of a single figure.
  previousMonthlyFeeAmount Int?
  /// Date the revalidation takes effect ("with effect from ...").
  effectiveFrom            DateTime?
  /// Facilities the park must provide within six months, free text.
  requiredFacilities       String?   @db.Text

  // ── HOD Operations: schedules the visit, then recommends ──
  /// Free-text recommendation recorded by the HOD of Operations once the
  /// inspection team has filed its checklist and comments.
  hodOpsRecommendation   String?   @db.Text
  hodOpsApprovedAt       DateTime?
  hodOpsApprovedByUserId String?

  /// HOD Parks Revalidation — the second review, after HOD Operations.
  hodApprovedAt          DateTime?
  commissionerApprovedAt DateTime?
  psApprovedAt           DateTime?
  /// Recorded when the PS sends the application back to HOD Operations.
  psRejectionReason      String?   @db.Text

  /// "TEMPORAL" | "PERMANENT" — chosen by the Commissioner at final approval.
  /// Drives the certificate wording and the validity period.
  approvalType           String?   @db.VarChar(20)

  validUntil DateTime?
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicant          User?               @relation("RevalidationApplicant", fields: [applicantUserId], references: [id])
  inspectionOfficer  User?               @relation("RevalidationInspector", fields: [inspectionOfficerId], references: [id])
  motorPark          MotorPark?          @relation("MotorParkRevalidation", fields: [motorParkId], references: [id], onDelete: SetNull)
  massTransitCompany MassTransitCompany? @relation("MassTransitRevalidation", fields: [massTransitCompanyId], references: [id], onDelete: SetNull)
  inspectionTeam     RevalidationInspector[]

  @@index([applicantUserId])
  @@index([status])
  @@index([motorParkId])
  @@index([massTransitCompanyId])
  @@index([dataSource])
  @@index([legacyRecordId])
}

// ==================== MARITIME / BOAT MODULE ====================

/// A revalidation inspection is carried out by a team of 2-4 officers: the HOD
/// of Operations (always included) plus up to three others. Exactly one member
/// is the LEAD and owns the checklist; the rest contribute a comment only.
model RevalidationInspector {
  id            String    @id @default(cuid())
  applicationId String
  userId        String
  /// The lead fills the checklist, findings and evidence. Everyone else
  /// leaves a comment that the HOD reads before recommending.
  isLead        Boolean   @default(false)
  comment       String?   @db.Text
  commentedAt   DateTime?
  createdAt     DateTime  @default(now())

  application RevalidationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User                    @relation("RevalidationTeamMember", fields: [userId], references: [id])

  @@unique([applicationId, userId])
  @@index([applicationId])
  @@index([userId])
}

