  policeOfficeLocation  String?
  policeReferenceNumber String?
  policeReceiptDateTime DateTime?

  // Vehicle particulars
  vehicleId             String? // Link to Vehicle if in system
  vehicleMake           String
  vehicleModel          String?
  vehicleType           VehicleType
  registrationNumber    String
  engineNumber          String
  chassisNumber         String
  identificationMark    String?
  speedometerReading    String? // e.g., "42,500 km"
  vehicleClassification String      @db.VarChar(50) // "COMMERCIAL", "PRIVATE"

  // Insurance details
  insuranceCompany    String?
  insuranceCertNumber String?
  insuranceCoverDate  DateTime?

  // Roadworthiness certificate
  roadworthinessCertNumber String?
  roadworthinessIssuePlace String?
  roadworthinessIssueDate  DateTime?

  // Mechanical/electrical assessment BEFORE accident
  conditionBeforeEngine              AVIRConditionBefore?
  conditionBeforeClutch              AVIRConditionBefore?
  conditionBeforeGearbox             AVIRConditionBefore?
  conditionBeforeBackAxle            AVIRConditionBefore?
  conditionBeforeBrakes              AVIRConditionBefore?
  conditionBeforeSteering            AVIRConditionBefore?
  conditionBeforeSuspension          AVIRConditionBefore?
  conditionBeforeLights              AVIRConditionBefore?
  conditionBeforeHorn                AVIRConditionBefore?
  conditionBeforeWipers              AVIRConditionBefore?
  conditionBeforeDirectionIndicators AVIRConditionBefore?
  conditionBeforeElectrical          AVIRConditionBefore?
  conditionBeforeSpeedometer         AVIRConditionBefore?
  conditionBeforeMirrors             AVIRConditionBefore?

  // Mechanical/electrical assessment AFTER accident/damages
  damagesDescription                String?             @db.Text
  conditionAfterEngine              AVIRConditionAfter?
  conditionAfterClutch              AVIRConditionAfter?
  conditionAfterGearbox             AVIRConditionAfter?
  conditionAfterBackAxle            AVIRConditionAfter?
  conditionAfterBrakes              AVIRConditionAfter?
  conditionAfterSteering            AVIRConditionAfter?
  conditionAfterSuspension          AVIRConditionAfter?
  conditionAfterLights              AVIRConditionAfter?
  conditionAfterHorn                AVIRConditionAfter?
  conditionAfterWipers              AVIRConditionAfter?
  conditionAfterDirectionIndicators AVIRConditionAfter?
  conditionAfterElectrical          AVIRConditionAfter?
  conditionAfterSpeedometer         AVIRConditionAfter?
  conditionAfterMirrors             AVIRConditionAfter?

  // Assessment and remarks
  recommendedCauseOfAccident String? @db.Text
  generalRemarks             String? @db.Text

  // VIO sign-off
  completedByVIOId    String
  vioStation          String?
  vioSignedAt         DateTime?
  vioDigitalSignature String?   @db.VarChar(500)

  // Form completion
  status      ApplicationStatus @default(SUBMITTED)
  completedAt DateTime?

  // Routing
  routedToSecurityAt   DateTime?
  routedToMotAt        DateTime?
  securityDashboardAck DateTime?
  motDashboardAck      DateTime?

  // Police copy delivery
  policeCopyDeliveryMethod String?   @db.VarChar(50) // "EMAIL", "PORTAL", "API"
  policeCopyDeliveredAt    DateTime?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  completedByVIO User @relation("CompletedByVIO", fields: [completedByVIOId], references: [id])

  @@index([status])
  @@index([completedByVIOId])
  @@index([accidentDateTime])
  @@index([reportNumber])
}

// ==================== NOTIFICATIONS ====================
