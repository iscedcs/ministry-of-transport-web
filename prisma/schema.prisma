// ==================== APPLICATION (Generic) ====================
// Base model for polymorphic application tracking

model Application {
  id String @id @default(cuid())

  applicationNumber String @unique
  applicationType   String @db.VarChar(50) // "MOTOR_PARK", "MASS_TRANSIT", "DRIVING_SCHOOL", "VIS", "AVIR"
  linkedEntityId    String // ID of specific application (MotorPark, MassTransitCompany, etc.)

  status          ApplicationStatus @default(SUBMITTED)
  createdByUserId String

