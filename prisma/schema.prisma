  residentialAddress String  @db.Text
  phoneNumber        String
  emailAddress       String
  maritalStatus      String  @db.VarChar(20) // SINGLE/MARRIED/DIVORCED/WIDOWED

  // SECTION B: Educational Qualifications
  // Handled via Document relation (linkedEntityType = "PARK_MONITOR_APP")

  // SECTION C: Employment History
  currentOccupation String?
  employer          String?
  positionHeld      String?

  // SECTION D: Health and Physical Fitness
  height         String? // e.g., "1.8m" or "180cm"
  weight         String? // e.g., "75kg"
  isMedicallyFit Boolean

  // SECTION E: Character and Security Screening
  hasCriminalConviction Boolean
  agreesToSecurityCheck Boolean

  // SECTION F: Enforcement Suitability
  reasonForJoining String @db.Text

  // SECTION G: References (JSON array of {name, phone, relation, email, address})
  referees Json

  // SECTION H: Next of Kin
  nextOfKinName         String
  nextOfKinPhone        String
  nextOfKinRelationship String
  nextOfKinAddress      String @db.Text

  // Application Tracking
  status ApplicationStatus @default(SUBMITTED)

