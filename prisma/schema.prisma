}

model TracasVehicle {
  id                     String    @id @default(cuid())
  registrationNumber     String    @unique
  fleetNumber            String    @unique
  category               String    @default("BUS") @db.VarChar(50)
  /** Seating capacity — its own field, not folded into the sub-category text. */
  capacity               Int?
  makeModel              String?
  engineNumber           String?
  chassisNumber          String?
  insuranceCertificateNo String?
  insuranceCommencement  DateTime?
  insuranceExpiry        DateTime?
  particularsIssueDate   DateTime?
  particularsExpiryDate  DateTime?
  assignedRoute          String?
  ownershipType          String    @default("GOVERNMENT_OWNED") @db.VarChar(50)
  // Distinguishes vehicles already operating under TRACAS at enrolment time
  // from those joining the company as part of this onboarding round.
  // "EXISTING" | "NEW_JOINER" — pre-existing rows default to EXISTING.
  enrollmentType         String    @default("EXISTING") @db.VarChar(30)
  joinedCompanyAt        DateTime?
  ownerName              String?
  ownerPhone             String?
  ownerAddress           String?   @db.Text
  ownerNIN               String?
  authorityRef           String    @unique

  authorityIssueDate  DateTime?    @default(now())
  authorityExpiryDate DateTime?
  status              PermitStatus @default(ACTIVE)

  // ── Letter of Authority approval chain ──
  // Existing rows adopt the default, so vehicles onboarded before this flow
  // enter at the MD's desk rather than being grandfathered as approved.
  letterStatus                 LetterApprovalStatus @default(PENDING_VIO_APPROVAL)
  vioApprovedAt                DateTime?
  vioApprovedByUserId          String?
  mdApprovedAt                 DateTime?
  mdApprovedByUserId           String?
  commissionerApprovedAt       DateTime?
  commissionerApprovedByUserId String?
  declinedAt                   DateTime?
  declinedByUserId             String?
  declinedAtStage              String?              @db.VarChar(40) // "MD" | "COMMISSIONER"
  declineReason                String?              @db.Text

  assignedDriverId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assignedDriver TracasDriver?  @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)
  sticker        TracasSticker?

  @@index([registrationNumber])
  @@index([fleetNumber])
  @@index([authorityRef])
  @@index([assignedDriverId])
  @@index([status])
  @@index([enrollmentType])
  @@index([letterStatus])
}

model TracasDriver {
  id                       String       @id @default(cuid())
  fullName                 String
  phoneNumber              String
  securityCode             String?      @unique
  email                    String?
  photoUrl                 String?      @db.Text
  nin                      String?
  asinNumber               String?
  residentialAddress       String?      @db.Text
  stateOfOrigin            String?
  lga                      String?
  dateOfBirth              DateTime?
  gender                   String?
  bloodGroup               String?
  maritalStatus            String?
  educationalQualification String?
  nextOfKinName            String?
  nextOfKinPhone           String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  guarantorName            String?
  guarantorPhone           String?
  guarantorAddress         String?      @db.Text
  licenseNumber            String?      @unique
  licenseIssueDate         DateTime?
  licenseExpiryDate        DateTime?
  operatorAssociation      String?
  notes                    String?      @db.Text
  status                   PermitStatus @default(ACTIVE)

  // ── ID card approval chain ──
  // Existing drivers adopt the default and enter at the VIO's desk.
  idCardStatus                   IdCardApprovalStatus @default(PENDING_VIO_APPROVAL)
  vioApprovedAt                  DateTime?
  vioApprovedByUserId            String?
  idMdApprovedAt                 DateTime?
  idMdApprovedByUserId           String?
  idCommissionerApprovedAt       DateTime?
  idCommissionerApprovedByUserId String?
  idDeclinedAt                   DateTime?
  idDeclinedByUserId             String?
  idDeclinedAtStage              String?              @db.VarChar(40) // "VIO" | "MD" | "COMMISSIONER"
  idDeclineReason                String?              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles TracasVehicle[]

  @@index([licenseNumber])
  @@index([phoneNumber])
  @@index([securityCode])
  @@index([status])
  @@index([idCardStatus])
}
