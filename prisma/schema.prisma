// Prisma Schema — Ministry of Transport Platform
// Reference: docs/IMPLEMENTATION_PLAN.md | docs/ROLES_AND_DUTIES.md | docs/EPICS.md
// 
// Architecture: Server Actions (Next.js) with no external backend
// Database: PostgreSQL (Neon) with Row-Level Security (RLS) via application logic
// Auth: Role-based access control (RBAC) with 7 distinct roles
//
// Modules:
// - Motor Parks (EPIC-002: FR-010–019)
// - Mass Transit (EPIC-003: FR-020–030)
// - Paystack Payments (EPIC-004: FR-040–044)
// - AVIR Reports (EPIC-006: FR-070–081)
// - Notifications (EPIC-007: FR-050–053)
// - Admin & Audit (EPIC-005: FR-001–004)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum UserRole {
  COMMISSIONER // Executive authority; final approvals
  PERMANENT_SECRETARY // Operational authority; staff management
  HOD_PARKS // Head of Parks Department
  HOD_VIS // Head of Vehicle Inspection Services
  HOD_TRANSPORT_OPS // Head of Transport Operations
  HOD_PARKS_REVALIDATION // Head of Parks Revalidation Services
  FIELD_INSPECTOR // Site inspections; field data entry
  FINANCE_OFFICER // Revenue tracking; payment reconciliation
  VEHICLE_INSPECTION_OFFICER // Mechanical assessment; AVIR completion
  EXTERNAL_APPLICANT // Public user: park owners, transit companies, driving schools
  PARK_MONITOR // Field staff who monitor parks and transit operations
  SYSTEM_ADMIN // Platform administration (internal) — full technical control
  ADMIN // Ministry administrator: staff & records, no system-level controls
  ICT_OFFICER // ICT Officer — Ministry Printing Center (sees every queue)
  ICT_OFFICER_TRACAS // ICT Officer scoped to TRACAS only (driver IDs + letters of authority)
  ENUMERATOR // Field enumeration — onboards vehicles & drivers across all modules
  TRACAS_MD // Ag. MD/CEO, Transport Company of Anambra State — first-stage letter approval
}

/// Approval chain for a TRACAS Letter of Authority.
/// Enumerator onboards → VIO verifies → MD signs → Commissioner signs → ICT prints.
/// The VIO stage is a verification gate and produces no signature; only the
/// MD and Commissioner sign the letter.
enum LetterApprovalStatus {
  PENDING_VIO_APPROVAL // Onboarded; awaiting Vehicle Inspection Officer
  PENDING_MD_APPROVAL // VIO cleared; awaiting Ag. MD/CEO
  PENDING_COMMISSIONER_APPROVAL // MD signed; awaiting Commissioner
  APPROVED // Both signatures applied — printable
  DECLINED // Rejected at either stage; returns to the enumerator
}

/// Approval chain for a TRACAS driver ID card.
/// Enumerator enrols → VIO verifies → MD signs → Commissioner signs → ICT prints.
/// Only the MD and Commissioner signatures appear on the card; the VIO stage
/// is a verification gate, not a signatory.
enum IdCardApprovalStatus {
  PENDING_VIO_APPROVAL // Enrolled; awaiting Vehicle Inspection Officer
  PENDING_MD_APPROVAL // VIO cleared; awaiting Ag. MD/CEO
  PENDING_COMMISSIONER_APPROVAL // MD signed; awaiting Commissioner
  APPROVED // Both signatures applied — printable
  DECLINED // Rejected at any stage; returns to the enumerator
}

enum ApplicationStatus {
  SUBMITTED // Initial submission
  UNDER_REVIEW // Documents being reviewed
  PENDING_PS_INSPECTION_APPROVAL // Inspection scheduled by HOD; awaiting PS clearance
  INSPECTION_SCHEDULED // PS cleared; assigned to the field inspector
  INSPECTION_IN_PROGRESS
  INSPECTION_COMPLETED // Inspection report submitted
  PENDING_HOD_APPROVAL
  PENDING_COMMISSIONER_APPROVAL
  PENDING_PS_APPROVAL
  PENDING_APPROVAL // Awaiting Commissioner/PS decision
  TEMPORAL_APPROVAL // Temporary permit to operate
  APPROVED // Approval issued
  REJECTED // Application rejected
  WAITLISTED // Application placed on waitlist
  REVOKED // Permit revoked post-approval
}

enum PermitStatus {
  ACTIVE
  EXPIRED
  REVOKED
  SUSPENDED
}

enum InspectionStatus {
  PENDING_PS_APPROVAL
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING // Payment initialized, awaiting customer action
  PROCESSING // Payment processing (Paystack webhook received)
  COMPLETED // Payment successful
  FAILED // Payment failed
  CANCELLED
  REFUNDED
}

enum NotificationType {
  APPLICATION_SUBMITTED
  INSPECTION_SCHEDULED
  INSPECTION_COMPLETED
  PERMIT_ISSUED
  PERMIT_REJECTED
  PERMIT_REVOKED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  RENEWAL_REMINDER_60DAYS
  RENEWAL_REMINDER_30DAYS
  SLA_BREACH
  SYSTEM_ALERT
}

enum NotificationChannel {
  EMAIL
  SMS
  BOTH
}

enum VehicleType {
  BUS
  MINIBUS
  TRUCK
  LIGHT_COMMERCIAL
  TANKER
  PRIVATE_CAR
  TAXI
  RIDE_HAILING
}

enum AVIRConditionBefore {
  GOOD
  FAIR
  POOR
  DEFECTIVE
}

enum AVIRConditionAfter {
  INTACT
  DAMAGED
  DESTROYED
  PARTIALLY_DAMAGED
}

// ==================== CORE USERS & AUTH ====================

model User {
  id           String   @id @default(cuid())
  email        String?  @unique // Null when the owner signs in with a phone number instead
  phone        String?  @unique // Primary contact — unique per account
  passwordHash String?  @db.VarChar(255) // bcrypt hash — null for passwordless applicants
  asinNumber   String?  @unique // Anambra State ID Number (for external applicants)
  firstName    String
  lastName     String
  role         UserRole
  departmentId String?  @db.VarChar(50) // For HOD roles: "parks", "vis", "transport-ops", "parks-revalidation"

  // Profile details
  designation        String? // Job title for Ministry staff
  stationLocation    String? // For Field Inspectors / VIOs
  registeredService  String? // "MOTOR_PARK" | "MASS_TRANSIT" — set on applicant registration; null for staff
  residentialAddress String? @db.Text // Personal/home address — collected at applicant registration

  // Account status
  isActive              Boolean   @default(true)
  hasEntranceExitAccess Boolean   @default(true)
  hasGatehouseAccess    Boolean   @default(true)
  emailVerified         DateTime?
  phoneVerified         DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  sessions               Session[]
  createdApplications    Application[]             @relation("CreatedByUser")
  assignedInspections    Inspection[]              @relation("AssignedToInspector")
  scheduledInspections   Inspection[]              @relation("ScheduledByHod")
  motorParks             MotorPark[]               @relation("ApplicationContact")
  massTransitCompanies   MassTransitCompany[]      @relation("ApplicationContact")
  notifications          NotificationPreference[]
  payments               Payment[]                 @relation("ProcessedByUser")
  avirs                  AVIRReport[]              @relation("CompletedByVIO")
  auditLogs              AuditLog[]                @relation("PerformedByUser")
  notificationsSent      Notification[]            @relation("SentToUser")
  motorParkDraft         MotorParkDraft?
  parkMonitorApp         ParkMonitorApplication?
  revalidationApps       RevalidationApplication[] @relation("RevalidationApplicant")
  inspectedRevalidations RevalidationApplication[] @relation("RevalidationInspector")
  revalidationTeams      RevalidationInspector[]   @relation("RevalidationTeamMember")
  revalidationDraft      RevalidationDraft?

  @@index([email])
  @@index([role])
  @@index([asinNumber])
  @@index([phone])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @db.VarChar(255)
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==================== DOCUMENTS ====================

model Document {
  id               String @id @default(cuid())
  uploadedByUserId String
  fileName         String
  fileType         String @db.VarChar(50) // pdf, jpg, png, docx, etc.
  fileSize         Int // bytes
  fileUrl          String @db.VarChar(500) // S3 or local path
  fileMimeType     String @db.VarChar(100)

  // Link to application (polymorphic via documentable pattern)
  linkedToType String @db.VarChar(50) // "MOTOR_PARK", "MASS_TRANSIT", etc.
  linkedToId   String // ID of the linked entity

  uploadedAt        DateTime  @default(now())
  // These fields track the LATEST verification state for quick status checks
  verifiedAt        DateTime?
  verifiedByUserId  String?
  verificationNotes String?   @db.Text

  // All accumulated review comments (one per reviewer, upserted)
  reviews DocumentReview[]

  @@index([linkedToType, linkedToId])
  @@index([uploadedByUserId])
}

/// Stores one review entry per reviewer per document.
/// Upserted on (documentId, reviewedByUserId) — so each reviewer
/// can update their own comment but never overwrites another reviewer's.
model DocumentReview {
  id               String   @id @default(cuid())
  documentId       String
  reviewedByUserId String
  reviewerRole     String   @db.VarChar(50) // snapshot of role at time of review
  reviewerName     String   @db.VarChar(200) // snapshot of "First Last"
  isApproved       Boolean
  notes            String?  @db.Text
  reviewedAt       DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, reviewedByUserId]) // one review slot per reviewer per doc
  @@index([documentId])
}

// ==================== MOTOR PARKS MODULE ====================
// Reference: docs/EPICS.md EPIC-002 (STORY-020 to STORY-033)
// Functional Requirements: FR-010 to FR-019

model MotorPark {
  id String @id @default(cuid())

  // Applicant details
  businessName          String
  transportCompanyName  String?
  // Park Location — split fields (replaces single locationAddress)
  streetAddress         String  @default(" ") // e.g. "12 Zik Avenue"
  lga                   String  @default(" ") // e.g. "Awka South"
  townCity              String  @default(" ") // e.g. "Awka"
  gpsCoordinates        String? // lat,lon format
  cacRegistrationNumber String? // optional — uploaded CAC doc takes precedence
  anssidNumber          String  @unique

  /// Permanent public identifier printed on the revalidation certificate:
  /// ANS-MOT-PK-000125 — Anambra State, Ministry of Transport, Park, serial.
  /// Assigned once, on first approval, and never reissued.
  parkId                String? @unique @db.VarChar(30)

  // Contact person (park owner link)
  // Nullable: a government-owned park has no applicant account, but it is
  // still a park on the register and still needs a Park ID.
  contactUserId String?
  contactPerson String
  contactPhone  String
  contactEmail  String

  // Park Manager expanded details
  managerResidentialAddress String? @db.Text // Manager home address (concatenated: street, LGA, city)
  nextOfKinName             String? // Next of kin full name (optional)
  nextOfKinPhone            String? // Next of kin phone in Nigerian format (optional)

  // Land documents (file references)
  landOwnershipDocId      String? // Document.id
  cacDocumentId           String? // Document.id
  corporateAsinDocumentId String? // Document.id

  // Facility photos
  toiletPhotoId        String? // Document.id
  waitingAreaPhotoId   String? // Document.id
  signagePhotoId       String? // Document.id
  waterFacilityPhotoId String? // Document.id
  /// Evidence that cameras are installed on site. Asked for on both the motor
  /// park and mass transit applications, and verified at inspection.
  cctvPhotoId          String? // Document.id

  // Status tracking
  applicationStatus ApplicationStatus @default(SUBMITTED)
  permitStatus      PermitStatus?

  // Inspection workflow
  firstInspectionId String?
  reInspectionId    String?

  // Permit details
  permitIssuedAt    DateTime?
  permitExpiresAt   DateTime?
  permitNumber      String?   @unique
  permitDocumentUrl String?   @db.VarChar(500) // Digital permit PDF

  // Fees
  assessedFeeAmount Int? // in kobo (from Payment.amount)
  monthlyLevyAmount Int? // in kobo

  // PS Recommendation
  psRecommendationNotes String? @db.Text

  // Revalidation
  lastRevalidatedAt   DateTime?
  nextRevalidationDue DateTime?

  // Audit
  appliedAt              DateTime  @default(now())
  hodApprovedAt          DateTime?
  psApprovedAt           DateTime?
  commissionerApprovedAt DateTime?
  approvedAt             DateTime?
  approvedByUserId       String? // Commissioner or PS
  revokedAt              DateTime?
  revocationReason       String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  applicant     User?                     @relation("ApplicationContact", fields: [contactUserId], references: [id])
  inspections   Inspection[]
  fees          MotorParkFee[]
  payments      Payment[]                 @relation("MotorParkPayment")
  notifications Notification[]            @relation("MotorParkNotification")
  parkStaff     ParkStaff[]
  revalidations RevalidationApplication[] @relation("MotorParkRevalidation")
  /// Set when this park was created from a mass transit terminal.
  terminal      Terminal?                 @relation("TerminalPark")

  @@index([applicationStatus])
  @@index([permitStatus])
  @@index([contactUserId])
  @@index([nextRevalidationDue])
  @@index([lga]) // Enables Commissioner "search by LGA" (report item 8)
}

enum ParkStaffStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model ParkStaff {
  id               String          @id @default(cuid())
  motorParkId      String
  parkSerialNumber Int // Sequential number scoped to park e.g. 1, 2, 3
  securityCode     String          @unique // e.g. MOT-[PARKNAME]-[NUMBER]
  profileUrl       String
  qrCodeUrl        String?         @db.VarChar(500)
  name             String
  role             String
  photoUrl         String?         @db.VarChar(500)
  status           ParkStaffStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  motorPark MotorPark @relation(fields: [motorParkId], references: [id], onDelete: Cascade)

  @@unique([motorParkId, parkSerialNumber])
  @@index([securityCode])
  @@index([motorParkId])
}

model Inspection {
  id String @id @default(cuid())

  // Inspection details
  inspectionType   String @db.VarChar(50) // "INITIAL", "RE_INSPECTION"
  linkedEntityType String @db.VarChar(50) // "MOTOR_PARK", "MASS_TRANSIT", "DRIVING_SCHOOL"
  linkedEntityId   String // ID of the park/company

  // Scheduling & Approvals
  scheduledDate      DateTime
  scheduledByUserId  String // HOD who scheduled
  status             InspectionStatus @default(PENDING_PS_APPROVAL)
  psApprovedAt       DateTime?
  psApprovedByUserId String?
  psRejectionReason  String?          @db.Text

  // Inspector assignment
  assignedToUserId         String
  inspectorStationLocation String?

  // Motor Park specific
  motorParkId String?
  motorPark   MotorPark? @relation(fields: [motorParkId], references: [id], onDelete: Cascade)

  // Inspection execution
  inspectionStartTime DateTime?
  inspectionEndTime   DateTime?
  checklist           InspectionChecklistResult[]

  // Findings
  overallAssessment   String? @db.Text // Narrative assessment

  /// Item-by-item verification of the facility, mirroring the revalidation
  /// inspection: JSON array of
  /// { key, section, label, declared, verified: "YES"|"NO"|"PARTIAL", note }.
  /// The terminal inspection previously captured only free text, which gave
  /// the HOD nothing specific to weigh.
  inspectionChecklist  Json?
  /// Evidence captured on site — JSON array of { url, caption }.
  evidenceUrls         Json?
  recommendedAction   String? @db.VarChar(100) // APPROVE, REJECT, CONDITIONAL
  inspectionReportUrl String? @db.VarChar(500) // PDF report

  // Audit
  completedAt       DateTime?
  completedByUserId String // Inspector who completed
  approvedAt        DateTime?
  approvedByUserId  String? // HOD approval
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  assignedTo  User @relation("AssignedToInspector", fields: [assignedToUserId], references: [id])
  scheduledBy User @relation("ScheduledByHod", fields: [scheduledByUserId], references: [id])

  @@index([linkedEntityType, linkedEntityId])
  @@index([assignedToUserId])
  @@index([status])
  @@index([motorParkId])
}

model InspectionChecklistResult {
  id              String @id @default(cuid())
  inspectionId    String
  checklistItemId String

  // Result
  isCompliant Boolean
  notes       String? @db.Text
  photoUrls   String? @db.Text // JSON array of photo URLs
  score       Int?

  // Audit
  recordedAt       DateTime @default(now())
  recordedByUserId String

  // Relations
  inspection    Inspection              @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checklistItem InspectionChecklistItem @relation(fields: [checklistItemId], references: [id])

  @@index([inspectionId])
  @@index([checklistItemId])
}

model InspectionChecklistItem {
  id         String @id @default(cuid())
  templateId String

  itemName     String
  itemCategory String  @db.VarChar(100) // "parking", "conveniences", "fire_safety", etc.
  description  String? @db.Text
  isRequired   Boolean @default(true)
  sortOrder    Int     @default(0)
  maxPoints    Int     @default(5)

  // Relations
  template InspectionChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  results  InspectionChecklistResult[]

  @@index([templateId])
}

model InspectionChecklistTemplate {
  id               String  @id @default(cuid())
  name             String
  linkedEntityType String  @db.VarChar(50) // "MOTOR_PARK", "MASS_TRANSIT"
  description      String? @db.Text
  isActive         Boolean @default(true)

  items     InspectionChecklistItem[]
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([linkedEntityType])
}

// Stores in-progress wizard data so applicants can resume across sessions/devices
model MotorParkDraft {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stepReached Int      @default(1)
  data        Json
  updatedAt   DateTime @updatedAt
}

model MotorParkFee {
  id          String        @id @default(cuid())
  motorParkId String
  feeType     String        @db.VarChar(50) // "APPLICATION", "MONTHLY_LEVY", "ANNUAL", "REVALIDATION"
  amount      Int // in kobo
  dueDate     DateTime
  paidAt      DateTime?
  paidAmount  Int? // in kobo
  status      PaymentStatus @default(PENDING)

  // Relations
  motorPark MotorPark @relation(fields: [motorParkId], references: [id], onDelete: Cascade)

  @@index([motorParkId])
  @@index([status])
  @@index([dueDate])
}

// ==================== MASS TRANSIT MODULE ====================
// Reference: docs/EPICS.md EPIC-003 (STORY-040 to STORY-051)
// Functional Requirements: FR-020 to FR-030

model MassTransitCompany {
  id String @id @default(cuid())

  // Company details
  companyName   String
  contactPerson String
  contactEmail  String
  contactPhone  String
  contactUserId String // User with EXTERNAL_APPLICANT role

  // Registration documents
  cacNumber               String  @unique
  asinNumber              String  @unique
  businessPremisesCert    String?
  ansaaRegistration       String?
  cacDocumentId           String? // Document.id
  landOwnershipDocId      String? // Document.id
  corporateAsinDocumentId String? // Document.id

  // ── Facility infrastructure photographs (terminal / depot) ──
  // A terminal becomes a motor park on approval, so it is asked for the same
  // evidence a park is asked for — including the camera installation.
  toiletPhotoId        String? // Document.id
  waitingAreaPhotoId   String? // Document.id
  signagePhotoId       String? // Document.id
  waterFacilityPhotoId String? // Document.id
  cctvPhotoId          String? // Document.id

  // Fleet details
  minFleetSize     Int     @default(5)
  currentFleetSize Int     @default(0)
  approvedColour   String? // Brand colour: "#RRGGBB"

  // Status
  applicationStatus ApplicationStatus @default(SUBMITTED)
  permitStatus      PermitStatus?
  permitIssuedAt    DateTime?
  permitExpiresAt   DateTime?
  permitNumber      String?           @unique
  permitDocumentUrl String?           @db.VarChar(500)

  // Inspection
  terminalInspectionId    String?
  terminalInspectionDueAt DateTime? // 5 working days per FR-023

  // Fees & PS Recommendation
  assessedFeeAmount     Int? // in kobo
  monthlyLevyAmount     Int? // in kobo
  psRecommendationNotes String? @db.Text

  // Revalidation
  lastRevalidatedAt   DateTime?
  nextRevalidationDue DateTime?

  // Audit
  appliedAt              DateTime  @default(now())
  hodApprovedAt          DateTime?
  psApprovedAt           DateTime?
  commissionerApprovedAt DateTime?
  approvedAt             DateTime?
  approvedByUserId       String? // Commissioner or PS
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  applicant             User                       @relation("ApplicationContact", fields: [contactUserId], references: [id])
  terminals             Terminal[]
  vehicles              Vehicle[]
  drivers               Driver[]
  staff                 CompanyStaff[]
  payments              Payment[]                  @relation("MassTransitPayment")
  notifications         Notification[]             @relation("MassTransitNotification")
  vehicleSubmissionReqs VehicleSubmissionRequest[]
  revalidations         RevalidationApplication[]  @relation("MassTransitRevalidation")

  @@index([applicationStatus])
  @@index([permitStatus])
  @@index([contactUserId])
}

// Terminal/Depot with manager details
model Terminal {
  id        String @id @default(cuid())
  companyId String

  // Terminal location
  locationAddress String  @db.Text
  gpsCoordinates  String?

  // Terminal Manager (required)
  managerName               String
  managerPhone              String
  managerEmail              String
  managerResidentialAddress String @db.Text

  /// Position within the company, from 1. Drives the certificate wording —
  /// "ABC LIMITED MOTORS TERMINAL ONE" — so it must stay stable once set.
  terminalNumber Int @default(1)

  /// The park this terminal became on approval. A terminal IS a park once the
  /// company is approved, so it gets a real MotorPark record rather than a
  /// parallel set of fields, and inherits staff, revalidation and permits.
  motorParkId String? @unique

  // Status
  inspectionStatus InspectionStatus @default(SCHEDULED)
  inspectionDueAt  DateTime?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company   MassTransitCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  motorPark MotorPark?         @relation("TerminalPark", fields: [motorParkId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

// Post-application: Commissioner/HOD requests applicant to submit vehicle details
model VehicleSubmissionRequest {
  id        String @id @default(cuid())
  companyId String

  // Number of vehicles to submit
  vehicleCount Int

  // Status
  status String @default("PENDING") // PENDING, SUBMITTED, APPROVED, REJECTED

  // Audit
  requestedAt     DateTime  @default(now())
  requestedByUser String // Commissioner/HOD who made the request
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedByUser  String?

  // Relations
  company  MassTransitCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicles VehicleSubmission[]

  @@index([companyId])
  @@index([status])
}

// Individual vehicle details submitted in response to VehicleSubmissionRequest
model VehicleSubmission {
  id                  String @id @default(cuid())
  submissionRequestId String

  // Vehicle particulars
  registrationNumber   String
  vehicleType          VehicleType
  make                 String
  model                String
  engineNumber         String      @unique
  chassisNumber        String      @unique
  routesServed         String?     @db.Text
  roadworthinessExpiry DateTime?

  // Audit
  createdAt DateTime @default(now())

  // Relations
  submissionRequest VehicleSubmissionRequest @relation(fields: [submissionRequestId], references: [id], onDelete: Cascade)

  @@index([submissionRequestId])
}

model Vehicle {
  id        String @id @default(cuid())
  companyId String

  // Vehicle particulars
  registrationNumber   String      @unique
  vehicleType          VehicleType
  make                 String // e.g., "Mercedes"
  model                String // e.g., "Sprinter 515"
  engineNumber         String      @unique
  chassisNumber        String      @unique
  identificationMark   String? // Driver ID / registration mark
  roadworthinessExpiry DateTime?

  // Fleet management
  assignedDriverId String?
  routesServed     String?      @db.Text // JSON array or comma-separated
  status           PermitStatus @default(ACTIVE)

  // QR Code
  qrCodeId          String?   @unique
  qrCodeGeneratedAt DateTime?

  // Audit
  addedAt       DateTime  @default(now())
  addedByUserId String
  removedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  company MassTransitCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver  Driver?            @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)
  qrCode  VehicleQRCode?     @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([registrationNumber])
  @@index([assignedDriverId])
}

model Driver {
  id        String @id @default(cuid())
  companyId String

  // Driver details
  fullName                String
  licenseNumber           String    @unique
  licenseExpiry           DateTime?
  phoneNumber             String
  ngnDrivingLicenseNumber String?

  // Proficiency card
  proficiencyCardId     String?   @unique
  proficiencyCardExpiry DateTime?

  // Status
  isActive Boolean      @default(true)
  status   PermitStatus @default(ACTIVE)

  // Audit
  addedAt       DateTime @default(now())
  addedByUserId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
